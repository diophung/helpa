# Generated locally by npm run setup:env. Never commit the resulting .env.
NODE_ENV=production
# External browser origin; must match Meta redirect origin exactly. HTTPS required in production.
PUBLIC_URL=https://localhost:8443
PORT=3000
# Caddy's hostname (no scheme). Public deployments: your real domain and ports 80/443.
DOMAIN=localhost
HTTP_PORT=8080
HTTPS_PORT=8443
# "internal" for local certificates. Set to your ACME contact email on the public VPS.
CADDY_TLS=internal
# Hex password avoids special characters in DATABASE_URL. Compose overrides the DB hostname to postgres.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://helpa:REPLACE@postgres:5432/helpa
# Independent random secrets. AUTH_SECRET protects sessions and Better Auth TOTP/recovery secrets.
AUTH_SECRET=
# 64 hex chars (32 bytes): wrapping key for AES-256-GCM envelope encryption of platform tokens.
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=v1
# One-time owner setup credential; 32+ characters. Registration closes after owner creation.
BOOTSTRAP_TOKEN=
# Global platform-write guard. Phase 0 registers no live publishing/reply transport in either mode.
HELPA_MODE=dry_run
# Initial business settings; after bootstrap use the Settings UI. 0 disables paid requests.
# Gateway execution is Phase 2; neither provider is called in Phase 0.
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_MONTHLY_CAP_USD=0
# API keys only, never a ChatGPT/Claude browser login or subscription token.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Facebook Page OAuth. Add this exact redirect in Meta:
# PUBLIC_URL/api/channels/facebook/callback
# Phase 0 requests pages_show_list; additional grants are inspected but do not enable future features.
META_APP_ID=
META_APP_SECRET=
# Verified against retrieved official OAuth/Page guides; intentionally pinned, configurable.
META_GRAPH_VERSION=v25.0
LOG_LEVEL=info
# Planned Phase 3 provider; documented decision, not an active SMS integration yet.
# Twilio and SMTP credentials will be introduced with their actual integration; not read in Phase 0.
# Backup script uses these only in its shell environment (export or pass explicitly).
# AGE_RECIPIENT=age1...
# BACKUP_DIR=/secure/off-host-mounted-backups/helpa

# Operator-only encryption rotation command (not read by web/worker):
# NEXT_ENCRYPTION_KEY=64-new-hex-characters
# NEXT_ENCRYPTION_KEY_ID=v2
# Test tooling only: dedicated Postgres login allowed to create/drop isolated test databases.
# TEST_DATABASE_URL=postgresql://helpa:helpa-local-test@127.0.0.1:54329/helpa

# Media is private and local by default. Docker has ffmpeg/ffprobe installed.
MEDIA_DIR=media
MEDIA_MAX_BYTES=104857600
MEDIA_MAX_DURATION=600
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# TikTok Login Kit Web redirect: PUBLIC_URL/api/channels/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Set approved only after TikTok confirms this product's Direct Post eligibility/audit.
# Scope grants alone do not satisfy eligibility; internal management tools may be ineligible.
TIKTOK_DIRECT_POST_ELIGIBILITY=unverified
# Verify ownership of PUBLIC_URL in TikTok before enabling server-hosted PULL_FROM_URL.
TIKTOK_URL_OWNERSHIP_VERIFIED=false
